# ==============================================================================
# TravelDesk Frontend — Environment Configuration
# Copy this file to `.env` for local production builds or configure these
# variables in your hosting provider / CI/CD pipeline.
# ==============================================================================

# Base URL for the Spring Boot REST API (no trailing slash).
# - Local development default: http://localhost:6969/api
# - Same-origin reverse proxy (Nginx/Caddy/Apache): /api
# - Separate API domain (requires CORS enabled on backend): https://api.example.com/api
API_URL=/api

# Application display name
APP_NAME=TravelDesk

# Enable verbose console diagnostics (role guard warnings, etc.)
# Set to false in production.
ENABLE_DEBUG_LOGS=false
